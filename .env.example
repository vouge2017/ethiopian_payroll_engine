# Environment Variables — EthioPayroll
# Copy to .env and fill in real values for local development.
# For Render: set these in the Render dashboard under Environment.

# ── Flask ──────────────────────────────────────────────────────────────
SECRET_KEY=generate-a-real-key-with-python3-c-import-secrets-print-secrets-token-urlsafe-32
FLASK_ENV=development
FLASK_APP=wsgi:app

# ── Database ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://payroll:change-me@localhost:5432/ethiopayroll
# For local SQLite (development only):
# DATABASE_URL=sqlite:///app.db

# ── Redis (for background PDF generation + rate limiting) ──────────────
REDIS_URL=redis://localhost:6379/0
# Render auto-sets this from the managed Redis instance.
# The worker service reads this same variable (Dockerfile.worker) and the
# /readyz worker heartbeat uses it too.
# For rate limiting fallback (no Redis):
# RATELIMIT_STORAGE_URI=memory://

# ── Encryption ─────────────────────────────────────────────────────────
# Key for encrypting sensitive fields (bank accounts, TIN).
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DB_ENCRYPTION_KEY=generate-a-real-fernet-key

# ── Uploads ────────────────────────────────────────────────────────────
# Uploads, deferred PDF payslips and deferred bank exports must survive
# redeploys and restarts. On Render, attach a persistent disk (or object
# storage) and point UPLOAD_FOLDER at the mounted path — never leave it under
# /tmp on a container host. If the app starts in production with a /tmp
# folder, it logs a durability warning at startup.
UPLOAD_FOLDER=./uploads

# ── Google OAuth (optional) ────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Sentry (optional — error tracking) ─────────────────────────────────
SENTRY_DSN=

# ── Demo mode ──────────────────────────────────────────────────────────
ENABLE_DEMO_MODE=false

# Public, monitored account-recovery contact (optional until confirmed).
SUPPORT_EMAIL=support@ethiopayroll.com

# ── PostgreSQL (for docker-compose) ────────────────────────────────────
POSTGRES_USER=payroll
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ethiopayroll
