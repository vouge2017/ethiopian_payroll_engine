# Copy to .env and fill in real values for local development.
# For Render: set these in the Render dashboard under Environment.
SECRET_KEY=generate-a-real-key-with-python-c-secrets-token-urlsafe-32
DATABASE_URL=postgresql://user:password@localhost:5432/ethiopayroll
CELERY_BROKER_URL=redis://localhost:6379/0
UPLOAD_FOLDER=./uploads
FLASK_ENV=development
ENABLE_DEMO_MODE=true
POSTGRES_USER=payroll
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ethiopayroll
